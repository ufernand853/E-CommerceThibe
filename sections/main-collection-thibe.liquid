{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<style>
  .thibe-plp{background:#fff;color:#141014}.thibe-plp__wrap{max-width:1400px;margin:0 auto;padding:0 32px}
  .thibe-plp__head{padding:28px 0 22px}.thibe-plp__crumb{font-size:12px;color:#4a4448;margin-bottom:10px}.thibe-plp__title{margin:0;font-size:30px;font-weight:600;line-height:1.15}
  .thibe-subcats{display:flex;gap:16px;overflow-x:auto;padding:0 0 32px;scrollbar-width:none}.thibe-subcats::-webkit-scrollbar{display:none}.thibe-subcat{flex:0 0 140px;color:#4a4448;text-decoration:none}.thibe-subcat__media{aspect-ratio:3/4;overflow:hidden;border:2px solid transparent;background:#eee}.thibe-subcat__media img{width:100%;height:100%;object-fit:cover}.thibe-subcat__name{text-align:center;font-size:12.5px;margin-top:10px}.thibe-subcat:hover .thibe-subcat__media,.thibe-subcat.is-active .thibe-subcat__media{border-color:#141014}.thibe-subcat:hover .thibe-subcat__name,.thibe-subcat.is-active .thibe-subcat__name{color:#141014;font-weight:600}
  .thibe-toolbar{border-top:1px solid #e3e0dd;border-bottom:1px solid #e3e0dd;padding:17px 0;margin-bottom:32px}.thibe-toolbar__inner{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:13.5px}.thibe-toolbar__count{white-space:nowrap}.thibe-toolbar .facets-container{padding:0!important}.thibe-toolbar .facets__form{margin:0!important;gap:20px}.thibe-toolbar .facet-filters{padding:0!important}.thibe-toolbar .facet-filters__label,.thibe-toolbar .product-count{display:none!important}
  .thibe-plp .collection{padding:0!important}.thibe-plp #product-grid{column-gap:24px;row-gap:34px}.thibe-plp .card-wrapper{height:100%}.thibe-plp .card{background:#fff;border:0;box-shadow:none}.thibe-plp .card__inner{--ratio-percent:133.333%!important;border-radius:0;overflow:hidden}.thibe-plp .card__media .media img{object-fit:cover}.thibe-plp .card__content{padding:0}.thibe-plp .card__information{padding:14px 0 0}.thibe-plp .card__heading{font-size:14px;font-weight:500;line-height:1.35;margin-bottom:4px}.thibe-plp .price{font-size:14px;font-weight:600}.thibe-plp .badge{font-size:10px;letter-spacing:.06em;text-transform:uppercase;border-radius:2px;background:#fff;color:#141014;border:0;padding:5px 9px}.thibe-plp .card__inner:after{content:'♡';position:absolute;right:12px;top:10px;z-index:3;width:24px;height:24px;display:grid;place-items:center;font-size:23px;color:#141014;background:rgba(255,255,255,.72);border-radius:50%;pointer-events:none}
  .thibe-plp__empty{text-align:center;padding:60px 0}.thibe-plp__pagination{padding:36px 0 70px}
  @media(max-width:749px){.thibe-plp__wrap{padding:0 18px}.thibe-plp__head{padding-top:20px}.thibe-plp__title{font-size:26px}.thibe-subcat{flex-basis:112px}.thibe-toolbar__inner{align-items:flex-start;flex-direction:column}.thibe-plp #product-grid{column-gap:12px;row-gap:28px}}
</style>

<section class="thibe-plp">
  <div class="thibe-plp__wrap">
    <div class="thibe-plp__head">
      <div class="thibe-plp__crumb"><a href="{{ routes.root_url }}">Inicio</a> / {{ collection.title }}</div>
      <h1 class="thibe-plp__title">{{ collection.title }}</h1>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="thibe-subcats" aria-label="Subcategorías">
        {% for block in section.blocks %}
          {% assign subcollection = block.settings.collection %}
          {% if subcollection != blank %}
            <a class="thibe-subcat{% if subcollection.handle == collection.handle %} is-active{% endif %}" href="{{ subcollection.url }}" {{ block.shopify_attributes }}>
              <div class="thibe-subcat__media">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180,280,420', alt: block.settings.title }}
                {% elsif subcollection.featured_image != blank %}
                  {{ subcollection.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180,280,420', alt: subcollection.title }}
                {% endif %}
              </div>
              <div class="thibe-subcat__name">{{ block.settings.title | default: subcollection.title }}</div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="thibe-toolbar">
      <div class="thibe-plp__wrap thibe-toolbar__inner">
        <div class="thibe-toolbar__count">Resultados: {{ collection.products_count }} artículos</div>
        {% if section.settings.enable_filtering or section.settings.enable_sorting %}
          <div id="main-collection-filters" data-id="{{ section.id }}">
            {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting, filter_type: 'horizontal', paginate: paginate %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="thibe-plp__wrap product-grid-container" id="ProductGridContainer">
      {% if collection.products.size == 0 %}
        <div class="thibe-plp__empty">No hay productos para mostrar.</div>
      {% else %}
        <ul id="product-grid" data-id="{{ section.id }}" class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop">
          {% assign skip_card_product_styles = false %}
          {% for product in collection.products %}
            <li class="grid__item">
              {% render 'card-product', card_product: product, media_aspect_ratio: 'portrait', image_shape: 'default', show_secondary_image: section.settings.show_secondary_image, show_vendor: false, show_rating: false, lazy_load: true, skip_styles: skip_card_product_styles, quick_add: 'none', section_id: section.id %}
            </li>
            {% assign skip_card_product_styles = true %}
          {% endfor %}
        </ul>
        {% if paginate.pages > 1 %}<div class="thibe-plp__pagination">{% render 'pagination', paginate: paginate, anchor: '' %}</div>{% endif %}
      {% endif %}
    </div>
  {% endpaginate %}
</section>

{% schema %}
{
  "name":"THIBE - Colección",
  "settings":[
    {"type":"range","id":"products_per_page","min":8,"max":36,"step":4,"default":16,"label":"Productos por página"},
    {"type":"checkbox","id":"show_secondary_image","default":true,"label":"Segunda imagen al pasar el mouse"},
    {"type":"checkbox","id":"enable_filtering","default":true,"label":"Activar filtros"},
    {"type":"checkbox","id":"enable_sorting","default":true,"label":"Activar orden"}
  ],
  "blocks":[
    {"type":"subcategory","name":"Subcategoría","settings":[
      {"type":"collection","id":"collection","label":"Colección"},
      {"type":"image_picker","id":"image","label":"Imagen opcional"},
      {"type":"text","id":"title","label":"Título opcional"}
    ]}
  ]
}
{% endschema %}
