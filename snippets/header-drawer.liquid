{% comment %}
  THIBE drawer navigation.
  Top-level categories behave as a single-selection group and are synchronized
  with the horizontal navigation.
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details
                      id="Details-menu-drawer-menu-item-{{ forloop.index }}"
                      name="thibe-main-menu"
                    >
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                        data-thibe-menu-key="{{ link.handle }}"
                      >
                        {{ link.title | escape }}
                        <span class="svg-wrapper">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </summary>

                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1"
                      >
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            <span class="svg-wrapper">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                            {{ link.title | escape }}
                          </button>

                          <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}aria-current="page"{% endif %}
                                  >
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <details id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}">
                                    <summary
                                      id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                      class="menu-drawer__menu-item link link--text list-menu__item focus-inset"
                                    >
                                      {{ childlink.title | escape }}
                                      <span class="svg-wrapper">
                                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                                      </span>
                                      <span class="svg-wrapper">
                                        {{- 'icon-caret.svg' | inline_asset_content -}}
                                      </span>
                                    </summary>

                                    <div
                                      id="childlink-{{ childlink.handle | escape }}"
                                      class="menu-drawer__submenu has-submenu gradient motion-reduce"
                                    >
                                      <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                                        <span class="svg-wrapper">
                                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                                        </span>
                                        {{ childlink.title | escape }}
                                      </button>

                                      <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                        {%- for grandchildlink in childlink.links -%}
                                          <li>
                                            <a
                                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                              href="{{ grandchildlink.url }}"
                                              class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                              {% if grandchildlink.current %}aria-current="page"{% endif %}
                                            >
                                              {{ grandchildlink.title | escape }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </details>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                      data-thibe-menu-key="{{ link.handle }}"
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<script>
(() => {
  const initThibeMenuState = () => {
    const drawer = document.querySelector('#menu-drawer');
    if (!drawer) return;

    const drawerTabs = [...drawer.querySelectorAll('.menu-drawer__navigation > .menu-drawer__menu > li > a[data-thibe-menu-key], .menu-drawer__navigation > .menu-drawer__menu > li > details > summary[data-thibe-menu-key]')];
    const horizontal = [...document.querySelectorAll('.thibe-subnav__link')];
    if (!drawerTabs.length || !horizontal.length) return;

    if (!document.getElementById('thibe-menu-state-style')) {
      const style = document.createElement('style');
      style.id = 'thibe-menu-state-style';
      style.textContent = `
        #menu-drawer .menu-drawer__navigation > .menu-drawer__menu > li > a.thibe-selected,
        #menu-drawer .menu-drawer__navigation > .menu-drawer__menu > li > details > summary.thibe-selected {
          background:#141014!important;color:#fff!important;border-color:#141014!important;
        }
      `;
      document.head.appendChild(style);
    }

    const normalize = (value) => (value || '').trim().toLowerCase();
    const keyFromHorizontal = (el) => normalize(el.textContent);
    const keyFromDrawer = (el) => normalize(el.textContent);

    const selectOne = (key, persist = true) => {
      const wanted = normalize(key);
      drawerTabs.forEach((tab) => tab.classList.toggle('thibe-selected', keyFromDrawer(tab) === wanted));
      horizontal.forEach((link) => link.classList.toggle('is-active', keyFromHorizontal(link) === wanted));
      if (persist && wanted) sessionStorage.setItem('thibeActiveMenu', wanted);
    };

    // Shopify/Liquid can mark several links active. Clear them first.
    horizontal.forEach((link) => link.classList.remove('is-active'));

    drawerTabs.forEach((tab) => {
      tab.addEventListener('click', () => selectOne(keyFromDrawer(tab), true));
    });

    horizontal.forEach((link) => {
      link.addEventListener('click', () => selectOne(keyFromHorizontal(link), true));
    });

    // On a real category URL, exact URL wins. Otherwise restore the user's last selection.
    const currentPath = location.pathname.replace(/\/$/, '') || '/';
    const exact = horizontal.find((link) => {
      try {
        const path = new URL(link.href, location.origin).pathname.replace(/\/$/, '') || '/';
        return path === currentPath;
      } catch (_) {
        return false;
      }
    });

    if (exact) {
      selectOne(keyFromHorizontal(exact), false);
    } else {
      const stored = sessionStorage.getItem('thibeActiveMenu');
      if (stored) selectOne(stored, false);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThibeMenuState, { once: true });
  } else {
    initThibeMenuState();
  }
})();
</script>
