{% comment %}
  THIBE drawer navigation.
  Top-level categories behave as tabs. The selected category is synchronized
  with the horizontal navigation and reveals quick links below.
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation" aria-label="Menú principal">
            <ul class="menu-drawer__menu thibe-drawer-tabs list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  <button
                    type="button"
                    id="HeaderDrawer-{{ link.handle }}"
                    class="menu-drawer__menu-item list-menu__item link link--text focus-inset thibe-drawer-tab"
                    data-thibe-menu-key="{{ link.handle }}"
                    aria-controls="ThibeDrawerPanel-{{ link.handle }}"
                    aria-selected="false"
                  >
                    {{ link.title | escape }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>

            <div class="thibe-drawer-panels">
              {%- for link in section.settings.menu.links -%}
                <section
                  id="ThibeDrawerPanel-{{ link.handle }}"
                  class="thibe-drawer-panel"
                  data-thibe-panel-key="{{ link.handle }}"
                  hidden
                >
                  <div class="thibe-drawer-primary-links">
                    {%- if link.links != blank -%}
                      {%- assign first_child = link.links.first -%}
                      <a href="{{ first_child.url }}" class="thibe-drawer-primary-link">
                        {{ first_child.title | escape }}
                      </a>
                    {%- endif -%}
                    <a href="{{ link.url }}" class="thibe-drawer-primary-link">Ver todo</a>
                  </div>

                  {%- if link.links.size > 1 -%}
                    <div class="thibe-drawer-popular-heading">
                      <span>Los más buscados</span>
                      <small>{{ link.links.size | minus: 1 }}</small>
                    </div>

                    <div class="thibe-drawer-popular-grid">
                      {%- for childlink in link.links offset: 1 limit: 6 -%}
                        {%- assign child_image = blank -%}
                        {%- if childlink.object != blank -%}
                          {%- if childlink.object.featured_image != blank -%}
                            {%- assign child_image = childlink.object.featured_image -%}
                          {%- elsif childlink.object.image != blank -%}
                            {%- assign child_image = childlink.object.image -%}
                          {%- endif -%}
                        {%- endif -%}

                        <a href="{{ childlink.url }}" class="thibe-drawer-chip">
                          <span class="thibe-drawer-chip__media" aria-hidden="true">
                            {%- if child_image != blank -%}
                              {{ child_image | image_url: width: 80, height: 80, crop: 'center' | image_tag: loading: 'lazy', widths: '40,60,80', alt: '' }}
                            {%- else -%}
                              <span class="thibe-drawer-chip__initial">{{ childlink.title | slice: 0 }}</span>
                            {%- endif -%}
                          </span>
                          <span class="thibe-drawer-chip__label">{{ childlink.title | escape }}</span>
                        </a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </section>
              {%- endfor -%}
            </div>
          </nav>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<script>
(() => {
  const initThibeMenuState = () => {
    const drawer = document.querySelector('#menu-drawer');
    if (!drawer) return;

    const drawerTabs = [...drawer.querySelectorAll('.thibe-drawer-tab[data-thibe-menu-key]')];
    const panels = [...drawer.querySelectorAll('.thibe-drawer-panel[data-thibe-panel-key]')];
    const horizontal = [...document.querySelectorAll('.thibe-subnav__link')];
    if (!drawerTabs.length) return;

    const normalize = (value) => (value || '').trim().toLowerCase();
    const keyFromHorizontal = (el) => normalize(el.textContent);
    const keyFromDrawer = (el) => normalize(el.dataset.thibeMenuKey || el.textContent);

    const selectOne = (key, persist = true) => {
      const wanted = normalize(key);

      drawerTabs.forEach((tab) => {
        const active = keyFromDrawer(tab) === wanted;
        tab.classList.toggle('thibe-selected', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        const active = normalize(panel.dataset.thibePanelKey) === wanted;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });

      horizontal.forEach((link) => {
        link.classList.toggle('is-active', keyFromHorizontal(link) === wanted);
      });

      if (persist && wanted) sessionStorage.setItem('thibeActiveMenu', wanted);
    };

    horizontal.forEach((link) => link.classList.remove('is-active'));

    drawerTabs.forEach((tab) => {
      tab.addEventListener('click', () => selectOne(keyFromDrawer(tab), true));
    });

    horizontal.forEach((link) => {
      link.addEventListener('click', () => selectOne(keyFromHorizontal(link), true));
    });

    const currentPath = location.pathname.replace(/\/$/, '') || '/';
    const exact = horizontal.find((link) => {
      try {
        const path = new URL(link.href, location.origin).pathname.replace(/\/$/, '') || '/';
        return path === currentPath;
      } catch (_) {
        return false;
      }
    });

    if (exact) {
      selectOne(keyFromHorizontal(exact), false);
      return;
    }

    const stored = sessionStorage.getItem('thibeActiveMenu');
    const storedTab = stored && drawerTabs.find((tab) => keyFromDrawer(tab) === normalize(stored));
    if (storedTab) {
      selectOne(stored, false);
      return;
    }

    selectOne(keyFromDrawer(drawerTabs[0]), false);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThibeMenuState, { once: true });
  } else {
    initThibeMenuState();
  }
})();
</script>
